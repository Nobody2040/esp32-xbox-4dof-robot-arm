(export (version "E")
  (design
    (source "esp32_robo_arm.kicad_sch")
    (date "2026-11-10")
    (tool "Eeschema 8.0")
  )
  (components
    (comp (ref "U1")
      (value "ESP32-DevKit")
      (footprint "Module:ESP32-DevKitC")
    )
    (comp (ref "PS1")
      (value "MB102_5V_Supply")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical")
    )
    (comp (ref "C1")
      (value "470uF_10V_Decoupling")
      (footprint "Capacitor_THT:CP_Radial_D8.0mm_P3.50mm")
    )
    (comp (ref "J1")
      (value "SG90_Base_GPIO13")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical")
    )
    (comp (ref "J2")
      (value "SG90_Shoulder_GPIO26")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical")
    )
    (comp (ref "J3")
      (value "SG90_Elbow_GPIO14")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical")
    )
    (comp (ref "J4")
      (value "SG90_Gripper_GPIO27")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical")
    )
  )
  (nets
    (net (code "1") (name "+5V_MB102")
      (node (ref "PS1") (pin "1") (pinfunction "+5V_RAIL"))
      (node (ref "C1")  (pin "1") (pinfunction "+"))
      (node (ref "J1")  (pin "2") (pinfunction "VCC_5V"))
      (node (ref "J2")  (pin "2") (pinfunction "VCC_5V"))
      (node (ref "J3")  (pin "2") (pinfunction "VCC_5V"))
      (node (ref "J4")  (pin "2") (pinfunction "VCC_5V"))
    )
    (net (code "2") (name "GND")
      (node (ref "U1")  (pin "GND") (pinfunction "GND"))
      (node (ref "PS1") (pin "2")   (pinfunction "GND_RAIL"))
      (node (ref "C1")  (pin "2")   (pinfunction "-"))
      (node (ref "J1")  (pin "3")   (pinfunction "GND"))
      (node (ref "J2")  (pin "3")   (pinfunction "GND"))
      (node (ref "J3")  (pin "3")   (pinfunction "GND"))
      (node (ref "J4")  (pin "3")   (pinfunction "GND"))
    )
    (net (code "3") (name "PWM_BASE_13")
      (node (ref "U1") (pin "13") (pinfunction "GPIO13_BASE"))
      (node (ref "J1") (pin "1")  (pinfunction "PWM_SIG"))
    )
    (net (code "4") (name "PWM_SHLDR_26")
      (node (ref "U1") (pin "26") (pinfunction "GPIO26_SHLDR"))
      (node (ref "J2") (pin "1")  (pinfunction "PWM_SIG"))
    )
    (net (code "5") (name "PWM_ELBOW_14")
      (node (ref "U1") (pin "14") (pinfunction "GPIO14_ELBOW"))
      (node (ref "J3") (pin "1")  (pinfunction "PWM_SIG"))
    )
    (net (code "6") (name "PWM_GRIP_27")
      (node (ref "U1") (pin "27") (pinfunction "GPIO27_GRIP"))
      (node (ref "J4") (pin "1")  (pinfunction "PWM_SIG"))
    )
  )
)
